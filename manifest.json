{
  "manifest_version": 3,
  "name": "Professor Companion",
  "version": "1.4.2",
  "description": "Enhances professor pages with publicly available academic information.",
  "permissions": ["activeTab", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "styles.css"],
      "matches": ["https://*.ratemyprofessors.com/*"]
    }
  ],
  "host_permissions": [
    "https://old.reddit.com/*",
    "https://www.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ratemyprofessors.com/*"
      ],
      "js": ["reddit.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
