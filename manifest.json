{
  "manifest_version": 3,
  "name": "Professor Companion",
  "version": "1.1.0",
  "description": "Enhances professor pages with publicly available academic information.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://*.ratemyprofessors.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
