{
  "manifest_version": 3,
  "name": "RMP Lookup",
  "version": "1.6.0",
  "description": "Enhances professor pages with publicly available academic information.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "styles.css", "assets/logo.png"],
      "matches": ["https://*.ratemyprofessors.com/*"]
    }
  ],
  "host_permissions": [
    "https://old.reddit.com/*",
    "https://www.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ratemyprofessors.com/*"
      ],
      "js": ["reddit.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
