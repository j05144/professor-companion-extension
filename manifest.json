{
  "manifest_version": 3,
  "name": "Professor Companion",
  "version": "1.2.0",
  "description": "Enhances professor pages with publicly available academic information.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ratemyprofessors.com/*"
      ],
      "js": ["reddit.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
