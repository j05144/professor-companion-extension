{
  "manifest_version": 3,
  "name": "Professor Companion",
  "version": "1.0.0",
  "description": "Enhances professor pages with publicly available academic information.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ratemyprofessors.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}